generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}


model Table {
  id        String   @id @default(cuid())
  number    Int      @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // A table can have many orders over time
  orders    Order[]  
}

model Order {
  id        String      @id @default(cuid())
  tableId   String
  table     Table       @relation(fields: [tableId], references: [id])
  
  // Track where the order is in the kitchen
  status    OrderStatus @default(PENDING)
  
  // The total price of the receipt
  total     Float
  
  // The list of food items on this specific order
  items     OrderItem[]
  
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  name      String
  price     Float
  quantity  Int
}

enum OrderStatus {
  PENDING    // Just sent by customer
  PREPARING  // Kitchen is cooking it
  DELIVERED  // Waiter brought it to the table
  PAID       // Customer paid, order closed
}